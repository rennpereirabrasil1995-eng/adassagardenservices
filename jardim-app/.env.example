# Copie este arquivo para ".env" e ajuste. Tudo é opcional.

# Nome que aparece no topo do app
APP_NAME=Gestão de Jardinagem

# Nome curto que aparece embaixo do ícone na tela inicial do celular
APP_SHORT_NAME=Jardinagem

# Fuso horário usado para "hoje", horários de início e fim
APP_TIMEZONE=Europe/London

# Só quando o app estiver online com HTTPS (veja README): use 1
COOKIE_SECURE=0
BEHIND_PROXY=0

# Se preencher, a tela de primeiro acesso pede este código.
# Recomendado ao colocar o app online, para ninguém criar a conta do dono antes de você.
SETUP_KEY=

# Chave interna de segurança das sessões. Se ficar vazio, o app cria uma
# automaticamente em instance/secret_key. Ao hospedar, defina uma fixa aqui.
SECRET_KEY=

# A partir de que hora (horário de Londres) saem os e-mails de lembrete da véspera
DAILY_EMAIL_HOUR=17

# Teto de espaço para as fotos, em MB (0 = sem teto). Quando chega nele, o app para de aceitar
# fotos novas, mas o resto continua funcionando. O PythonAnywhere grátis tem 512 MB no total.
PHOTO_SPACE_MB=300
